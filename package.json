{
  "name": "nagarathars-chess",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && tsc --noEmit && npm run build",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "photos:committee": "node scripts/process-committee-photos.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node --import tsx --test \"src/**/*.test.{ts,tsx}\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/client-ses": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.12.0",
    "@react-pdf/renderer": "^4.9.0",
    "browser-image-compression": "^2.0.2",
    "next": "^16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.12.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "onnxruntime-node": "^1.17.3",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.8",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@prisma/client@6.12.0": true,
    "prisma@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "esbuild@0.28.2": true
  }
}
