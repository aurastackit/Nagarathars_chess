generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tournament {
  id                   String         @id @default(cuid())
  slug                 String         @unique
  title                String
  description          String
  category             String
  format               String         @default("classical")
  startDate            DateTime
  endDate              DateTime
  venue                String
  city                 String
  entryFee             Int            @default(0)
  maxParticipants      Int?
  registrationDeadline DateTime
  posterImageUrl       String?
  brochurePdfUrl       String?
  timeControl          String?
  rounds               Int?
  prizeStructure       String?
  rulesText            String?
  status               String         @default("draft")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  registrations        Registration[]
}

model Registration {
  id                 String     @id @default(cuid())
  tournament         Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId       String
  fullName           String
  email              String
  phone              String
  dob                DateTime?
  gender             String?
  city               String?
  address            String?
  fideId             String?
  rating             Int?
  kovil              String?
  pirivu             String?
  native             String?
  fatherName         String?
  motherName         String?
  fatherGrandparents String?
  motherGrandparents String?
  motherNative       String?
  motherKovil        String?
  motherPirivu       String?
  sangamMember       Boolean    @default(false)
  aadhaarImageData   String?
  passportPhotoData  String?
  ageCategory        String?
  status             String     @default("registered")
  registeredAt       DateTime   @default(now())

  @@unique([tournamentId, email])
}

model ClassProgram {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  level           String
  sessionType     String            @default("group")
  price           Int               @default(0)
  maxGroupSize    Int?
  durationMinutes Int               @default(60)
  description     String
  scheduleText    String
  instructorName  String
  bannerImageUrl  String?
  isOnline        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  enrollments     ClassEnrollment[]
}

model ClassEnrollment {
  id             String       @id @default(cuid())
  classProgram   ClassProgram @relation(fields: [classProgramId], references: [id], onDelete: Cascade)
  classProgramId String
  fullName       String
  email          String
  phone          String
  fideId         String?
  message        String?
  enrolledAt     DateTime     @default(now())

  @@unique([classProgramId, email])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
