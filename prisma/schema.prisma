generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tournament {
  id                   String         @id @default(cuid())
  slug                 String         @unique
  title                String
  description          String
  category             String
  format               String         @default("classical")
  startDate            DateTime
  endDate              DateTime
  venue                String
  city                 String
  entryFee             Int            @default(0)
  maxParticipants      Int?
  registrationDeadline DateTime
  posterImageUrl       String?
  brochurePdfUrl       String?
  timeControl          String?
  rounds               Int?
  prizeStructure       String?
  rulesText            String?
  status               String         @default("draft")
  resultsPublished     Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  registrations        Registration[]
  resultRounds         Round[]
}

model Registration {
  id                 String     @id @default(cuid())
  tournament         Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId       String
  fullName           String
  email              String
  phone              String
  dob                DateTime?
  gender             String?
  city               String?
  address            String?
  fideId             String?
  rating             Int?
  kovil              String?
  pirivu             String?
  native             String?
  fatherName         String?
  motherName         String?
  fatherGrandparents String?
  motherGrandparents String?
  motherNative       String?
  motherKovil        String?
  motherPirivu       String?
  sangamMember       Boolean    @default(false)
  // Legacy base64 fields from the single-page form — kept for historical rows, no longer written to.
  aadhaarImageData   String?
  passportPhotoData  String?
  // Current uploads: private S3 object keys only, never a public URL.
  ageProofType       String?
  ageProofKey        String?
  passportPhotoKey   String?
  consentAccepted    Boolean    @default(false)
  guardianName       String?
  guardianConsent    Boolean    @default(false)
  ageCategory        String?
  status             String     @default("pending")
  rejectionReason    String?
  paymentStatus      String     @default("not_required")
  amountPaid         Int?
  razorpayOrderId    String?
  razorpayPaymentId  String?
  player             Player?    @relation(fields: [playerId], references: [id])
  playerId           String?
  registeredAt       DateTime   @default(now())

  @@unique([tournamentId, email, dob])
}

/** A person who has played in tournaments, matched across tournaments by email. */
model Player {
  id            String         @id @default(cuid())
  fullName      String
  email         String         @unique
  dob           DateTime?
  createdAt     DateTime       @default(now())
  registrations Registration[]
  whiteGames    Pairing[]      @relation("WhitePairings")
  blackGames    Pairing[]      @relation("BlackPairings")
}

model Round {
  id           String     @id @default(cuid())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId String
  number       Int
  createdAt    DateTime   @default(now())
  pairings     Pairing[]

  @@unique([tournamentId, number])
}

/** One board's game for a round. `blackPlayerId` null means `whitePlayer` had a bye. */
model Pairing {
  id            String   @id @default(cuid())
  round         Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId       String
  board         Int?
  whitePlayer   Player?  @relation("WhitePairings", fields: [whitePlayerId], references: [id])
  whitePlayerId String?
  blackPlayer   Player?  @relation("BlackPairings", fields: [blackPlayerId], references: [id])
  blackPlayerId String?
  // "1-0" | "0-1" | "0.5-0.5" | "BYE" | null (not yet played)
  result        String?

  @@index([roundId])
}

model ClassProgram {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  level           String
  sessionType     String            @default("group")
  price           Int               @default(0)
  maxGroupSize    Int?
  durationMinutes Int               @default(60)
  description     String
  scheduleText    String
  instructorName  String
  bannerImageUrl  String?
  isOnline        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  enrollments     ClassEnrollment[]
}

model ClassEnrollment {
  id             String       @id @default(cuid())
  classProgram   ClassProgram @relation(fields: [classProgramId], references: [id], onDelete: Cascade)
  classProgramId String
  fullName       String
  email          String
  phone          String
  fideId         String?
  message        String?
  enrolledAt     DateTime     @default(now())

  @@unique([classProgramId, email])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model AdminActivityLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  targetType String
  targetId   String
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}
