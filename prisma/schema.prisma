generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tournament {
  id                   String         @id @default(cuid())
  slug                 String         @unique
  title                String
  description          String
  category             String
  format               String         @default("classical")
  startDate            DateTime
  endDate              DateTime
  venue                String
  city                 String
  entryFee             Int            @default(0)
  maxParticipants      Int?
  registrationDeadline DateTime
  posterImageUrl       String?
  brochurePdfUrl       String?
  timeControl          String?
  rounds               Int?
  prizeStructure       String?
  rulesText            String?
  status               String         @default("draft")
  resultsPublished     Boolean        @default(false)
  /// Last number handed out for this tournament's registration numbers (NCC26-U11-0042 → 42).
  registrationSeq      Int            @default(0)
  /// Set when the event is rescheduled: the start date players originally signed up for.
  previousStartDate    DateTime?
  dateChangedAt        DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  registrations        Registration[]
  resultRounds         Round[]
  galleryItems         GalleryItem[]
}

model Registration {
  id                    String              @id @default(cuid())
  tournament            Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId          String
  fullName              String
  email                 String
  phone                 String
  dob                   DateTime?
  gender                String?
  city                  String?
  address               String?
  fideId                String?
  rating                Int?
  kovil                 String?
  pirivu                String?
  native                String?
  fatherName            String?
  motherName            String?
  fatherGrandparents    String?
  motherGrandparents    String?
  motherNative          String?
  motherKovil           String?
  motherPirivu          String?
  sangamMember          Boolean             @default(false)
  // Name of the relative who belongs to the Sangam; the form requires it when sangamMember is ticked.
  sangamRelativeName    String?
  // Legacy base64 fields from the single-page form — kept for historical rows, no longer written to.
  aadhaarImageData      String?
  passportPhotoData     String?
  // Current uploads: private S3 object keys only, never a public URL.
  ageProofType          String?
  ageProofKey           String?
  passportPhotoKey      String?
  consentAccepted       Boolean             @default(false)
  guardianName          String?
  guardianConsent       Boolean             @default(false)
  ageCategory           String?
  /// Human-readable number, e.g. NCC26-U11-0042: tournament year, category at submission, per-tournament sequence.
  /// Always set by the app; nullable only until a follow-up migration (old code may still insert during a deploy).
  registrationNo        String?
  /// Random token in the ID card's QR code (/verify/<token>); set when the registration is first confirmed, never changed.
  verifyToken           String?             @unique
  /// pending | confirmed | rejected | changes_requested | withdrawn (transitions: src/lib/registration-status.ts)
  status                String              @default("pending")
  /// Shown to the player: why it was rejected or what needs changing.
  rejectionReason       String?
  /// Internal only, never shown to the player.
  adminNotes            String?
  reviewedAt            DateTime?
  reviewedBy            String?
  withdrawnAt           DateTime?
  withdrawReason        String?
  /// After the event date changes: pending | accepted | declined (null = no change to respond to).
  dateChangeResponse    String?
  dateChangeRespondedAt DateTime?
  paymentStatus         String              @default("not_required")
  amountPaid            Int?
  razorpayOrderId       String?
  razorpayPaymentId     String?
  player                Player?             @relation(fields: [playerId], references: [id])
  playerId              String?
  registeredAt          DateTime            @default(now())
  updatedAt             DateTime            @default(now()) @updatedAt
  events                RegistrationEvent[]

  @@unique([tournamentId, email, dob])
  @@unique([tournamentId, registrationNo])
}

/** A person who has played in tournaments, matched across tournaments by email. */
model Player {
  id            String         @id @default(cuid())
  fullName      String
  email         String         @unique
  dob           DateTime?
  createdAt     DateTime       @default(now())
  registrations Registration[]
  whiteGames    Pairing[]      @relation("WhitePairings")
  blackGames    Pairing[]      @relation("BlackPairings")
}

model Round {
  id           String     @id @default(cuid())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId String
  number       Int
  createdAt    DateTime   @default(now())
  pairings     Pairing[]

  @@unique([tournamentId, number])
}

/** One board's game for a round. `blackPlayerId` null means `whitePlayer` had a bye. */
model Pairing {
  id            String   @id @default(cuid())
  round         Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId       String
  board         Int?
  whitePlayer   Player?  @relation("WhitePairings", fields: [whitePlayerId], references: [id])
  whitePlayerId String?
  blackPlayer   Player?  @relation("BlackPairings", fields: [blackPlayerId], references: [id])
  blackPlayerId String?
  // "1-0" | "0-1" | "0.5-0.5" | "BYE" | null (not yet played)
  result        String?

  @@index([roundId])
}

model ClassProgram {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  level           String
  sessionType     String            @default("group")
  price           Int               @default(0)
  maxGroupSize    Int?
  durationMinutes Int               @default(60)
  description     String
  scheduleText    String
  instructorName  String
  bannerImageUrl  String?
  isOnline        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  enrollments     ClassEnrollment[]
}

model ClassEnrollment {
  id             String       @id @default(cuid())
  classProgram   ClassProgram @relation(fields: [classProgramId], references: [id], onDelete: Cascade)
  classProgramId String
  fullName       String
  email          String
  phone          String
  fideId         String?
  message        String?
  enrolledAt     DateTime     @default(now())

  @@unique([classProgramId, email])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model AdminActivityLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  targetType String
  targetId   String
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

/** Collected when the homepage/classes page has nothing published, so we can follow up once classes go live. */
model ClassWaitlist {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?
  /// Optional "Interested in" answer: beginner | intermediate | advanced | not_sure
  interestLevel String?
  createdAt     DateTime @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
}

enum VideoProvider {
  NONE
  YOUTUBE
  DRIVE
  S3
}

enum GallerySection {
  TOURNAMENT_DAY
  YOUNG_CHAMPIONS
  PRIZE_CEREMONY
  FAMILIES_COMMUNITY
  BEHIND_THE_SCENES
  CLASSES
  HIGHLIGHTS
}

/** A single gallery photo or video. Replaces the old hardcoded src/lib/featured-photos.ts list and the Tournament/ClassProgram poster fields as the one real source of gallery content going forward (those two fields are left as-is for now — this doesn't touch them). */
model GalleryItem {
  id            String         @id @default(cuid())
  url           String
  mediaType     MediaType      @default(IMAGE)
  videoProvider VideoProvider  @default(NONE)
  thumbnailUrl  String?
  caption       String?
  altText       String?
  section       GallerySection @default(TOURNAMENT_DAY)
  sortOrder     Int            @default(0)
  takenAt       DateTime?
  isPublished   Boolean        @default(true)
  tournament    Tournament?    @relation(fields: [tournamentId], references: [id])
  tournamentId  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([section, sortOrder])
}

/** Tracks emailed one-time-code verification for a given address (e.g. before a tournament registration is accepted). */
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  otpCodes        OtpCode[]
}

/** One requested email-verification code for a User. Superseded codes are left in place (not deleted) for audit/rate-limit history. */
model OtpCode {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
}

/// Audit trail for one registration: what happened, who did it, and an optional note.
model RegistrationEvent {
  id             String       @id @default(cuid())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String
  /// submitted | edited | confirmed | rejected | changes_requested | reopened | withdrawn |
  /// email_sent | email_failed | document_viewed | date_change_confirmed
  type           String
  /// player | admin | system
  actorType      String
  /// Admin email or the player's email; null for system events.
  actor          String?
  note           String?
  createdAt      DateTime     @default(now())

  @@index([registrationId, createdAt])
  @@index([type, createdAt])
}
