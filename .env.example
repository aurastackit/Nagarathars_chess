# Production: hosted Postgres (Supabase pooled connection + direct connection for migrations)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].pooler.supabase.com:5432/postgres"

# For local dev without Supabase, you can point DATABASE_URL at a local Postgres instead, e.g.:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nagarathars_chess"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nagarathars_chess"

# Admin login (change these before sharing the link)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"

# NextAuth
AUTH_SECRET="replace-with-a-random-string"

# AWS S3 — private bucket for registration document uploads (pre-signed URLs only, never public)
S3_BUCKET_NAME=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Razorpay — required only for paid tournaments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Resend — leave blank to keep emailing as a console.log stub (see src/lib/notify.ts)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Nagarathar's Chess <registrations@example.com>"
