# Local SQLite file for the trial run (no external account needed).
DATABASE_URL="file:./dev.db"

# When ready for a shareable link / real launch, switch to a hosted Postgres URL instead, e.g.:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].pooler.supabase.com:5432/postgres"
# (and change the `datasource` provider in prisma/schema.prisma from "sqlite" back to "postgresql")

# Admin login for the trial (change these before sharing the link)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"

# NextAuth
AUTH_SECRET="replace-with-a-random-string"
